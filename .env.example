# GEMINI_API_KEY: Required for Gemini Live Audio and AI Responses
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: Production or local deployment URL
APP_URL="http://localhost:3000"

# Optional: PostgreSQL Database Connection String (for persistent leads)
# DATABASE_URL="postgres://user:password@host:port/dbname"

# Optional: Google OAuth Credentials (for Admin Dashboard)
# GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
# GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"
# ALLOWED_ADMIN_EMAILS="admin@example.com"
